<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="main_button_disable_wifi">WiFi 비활성화</string>
    <string name="main_button_enable_wifi">WiFi 활성화</string>
    <string name="main_label_app_description">이 앱을 사용하면 WiFi를 활성화 및 비활성화할 수 있습니다.</string>
    <string name="main_label_compatibility_description">Wi-Fi를 사용할 수 있도록 이전 호환성 버전이 포함되어 있습니다.</string>
    <string name="main_label_github_description">코드 소스는 앱을 다운로드할 수 있는 GitHub에서 사용할 수 있습니다.</string>
    <string name="main_title_automatic">AutoHotspot로 Wi-Fi 자동 전환</string>
    <string name="main_body_automatic">설정한 규칙이 실행되면 AutoHotspot이 이 도우미 앱에 로컬 요청을 보내 Wi-Fi를 켜거나 끕니다. WiFiControl을 설치된 상태로 두세요. 이 화면을 열어 둘 필요는 없습니다.</string>
    <string name="main_title_manual">Wi-Fi 직접 테스트</string>
    <string name="main_body_manual">이 버튼으로 Android가 이 도우미 앱의 Wi-Fi 전환을 허용하는지 확인하세요. 자동 전환은 AutoHotspot에서 설정합니다.</string>
    <string name="main_title_compatibility">Android가 경고를 표시하는 이유</string>
    <string name="main_body_compatibility">이 도우미 앱은 Wi-Fi를 전환하기 위해 이전 Android 호환성 대상을 사용합니다. 이 때문에 Android가 오래된 앱이라는 경고를 표시할 수 있습니다.</string>
    <string name="main_title_transparency">오픈 소스, 기기 내 처리</string>
    <string name="main_body_transparency">Wi-Fi 제어 요청은 기기 안에서 처리됩니다. WiFiControl은 인터넷 액세스를 요청하지 않습니다. 모든 소스 코드는 GitHub에 공개되어 있어 직접 확인할 수 있습니다.</string>
    <string name="main_button_source">GitHub에서 소스 코드 확인</string>
    <string name="main_status_enabled">Wi-Fi 켜짐</string>
    <string name="main_status_disabled">Wi-Fi 꺼짐</string>
    <string name="main_status_changing">Wi-Fi 전환 중…</string>
    <string name="main_error_change_rejected">Android가 지금은 Wi-Fi를 변경하지 못했습니다.</string>
    <string name="main_error_open_source">GitHub를 열 수 있는 앱이 없습니다.</string>
    <string name="main_version">버전: %1$s (%2$d)</string>
</resources>